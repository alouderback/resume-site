---
import { interests } from '../data/interests';
import { withBase } from '../lib/paths';
---

<section class="carousel-block" aria-labelledby="into-heading">
  <div class="head">
    <div>
      <span class="eyebrow">Outside work</span>
      <h2 id="into-heading">Things I'm into</h2>
      <p class="lede">Books, screens, and controllers currently in rotation.</p>
    </div>
    <div class="controls">
      <button type="button" data-carousel-prev aria-label="Scroll left">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="m15 6-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"
          ></path>
        </svg>
      </button>
      <button type="button" data-carousel-next aria-label="Scroll right">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="m9 6 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"
          ></path>
        </svg>
      </button>
    </div>
  </div>

  <ul
    class="track"
    data-carousel-track
    tabindex="0"
    role="region"
    aria-label="Things I'm into, scrollable list"
  >
    {
      interests.map((item) => {
        const Tag = item.url ? 'a' : 'div';
        const attrs = item.url ? { href: item.url, rel: 'noopener' } : {};
        return (
          <li class="item">
            <Tag class="card-link" {...attrs}>
              <div
                class="cover"
                style={`--c1:${item.palette[0]};--c2:${item.palette[1]}`}
                data-has-image={item.cover ? 'true' : 'false'}
                data-fit={item.fit ?? 'cover'}
              >
                {item.cover ? (
                  <img
                    src={withBase(`/covers/${item.cover}`)}
                    alt={`Cover of ${item.title}`}
                    loading="lazy"
                    decoding="async"
                    width="331"
                    height="500"
                  />
                ) : (
                  <div class="fallback" aria-hidden="true">
                    {item.backdrop === 'eagles' && (
                      <svg
                        class="backdrop"
                        viewBox="0 0 200 300"
                        preserveAspectRatio="xMidYMid slice"
                      >
                        {/* Sleeve stripes, the way they run on a kelly green jersey. */}
                        <g class="stripes">
                          <path d="M-40 250 L70 60 L96 60 L-14 250Z" />
                          <path d="M4 250 L114 60 L126 60 L16 250Z" />
                          <path d="M40 250 L150 60 L162 60 L52 250Z" />
                        </g>
                        {/* Wing silhouette, drawn rather than lifted from the team mark. */}
                        <g class="wing">
                          <path d="M18 118c44-8 78 4 103 30 22 22 32 51 34 84-30-14-52-36-64-58-11-20-14-38-13-52-16 12-32 16-46 14 9-8 14-16 15-24-14 6-27 7-40 4 4-6 8-10 11-12Z" />
                        </g>
                      </svg>
                    )}
                    <span class="fb-medium">{item.medium}</span>
                    <span class="fb-title">{item.title}</span>
                    <span class="fb-creator">{item.creator}</span>
                  </div>
                )}
                <span class="medium-tag">{item.medium}</span>
              </div>
              <div class="meta">
                <p class="title">{item.title}</p>
                <p class="creator">
                  {item.creator} · {item.year}
                </p>
                <p class="note">{item.note}</p>
              </div>
            </Tag>
          </li>
        );
      })
    }
  </ul>
</section>

<script>
  const track = document.querySelector<HTMLElement>('[data-carousel-track]');
  const prev = document.querySelector<HTMLButtonElement>('[data-carousel-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-carousel-next]');

  function step() {
    const first = track?.querySelector<HTMLElement>('.item');
    return first ? first.getBoundingClientRect().width + 18 : 260;
  }

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const behavior: ScrollBehavior = reduced ? 'auto' : 'smooth';

  prev?.addEventListener('click', () => track?.scrollBy({ left: -step(), behavior }));
  next?.addEventListener('click', () => track?.scrollBy({ left: step(), behavior }));

  // Disable the arrows when there is nothing further to scroll to.
  function sync() {
    if (!track || !prev || !next) return;
    const max = track.scrollWidth - track.clientWidth - 2;
    prev.disabled = track.scrollLeft <= 2;
    next.disabled = track.scrollLeft >= max;
  }
  track?.addEventListener('scroll', sync, { passive: true });
  window.addEventListener('resize', sync);
  sync();
</script>

<style>
  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.4rem;
    flex-wrap: wrap;
  }
  .head .lede {
    margin: 0.4rem 0 0;
    font-size: 1rem;
  }
  .controls {
    display: flex;
    gap: 0.4rem;
  }
  .controls button {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-muted);
    cursor: pointer;
  }
  .controls button:hover:not(:disabled) {
    color: var(--text);
    border-color: var(--border-strong);
  }
  .controls button:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(196px, 21%);
    gap: 18px;
    list-style: none;
    margin: 0;
    padding: 0 0 0.85rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
  }
  .track:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 4px;
  }
  .item {
    scroll-snap-align: start;
  }

  .card-link {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .cover {
    position: relative;
    aspect-ratio: 2 / 3;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    background: linear-gradient(150deg, var(--c1), var(--c2));
    transition: transform 0.18s ease;
  }
  .card-link:hover .cover {
    transform: translateY(-3px);
  }
  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Square box art is letterboxed against the palette rather than cropped. */
  .cover[data-fit='contain'] img {
    object-fit: contain;
    padding: 6%;
  }

  .fallback {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.3rem;
    padding: 1rem 0.9rem;
    color: #fff;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.45);
  }
  .backdrop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .backdrop .stripes path {
    fill: #ffffff;
    opacity: 0.14;
  }
  .backdrop .stripes path:nth-child(2) {
    fill: #05130a;
    opacity: 0.3;
  }
  .backdrop .wing path {
    fill: #ffffff;
    opacity: 0.2;
  }
  /* Keep the text above the artwork and readable over it. */
  .fallback > span {
    position: relative;
  }
  .fb-medium {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.85;
  }
  .fb-title {
    font-size: 1.12rem;
    font-weight: 680;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .fb-creator {
    font-size: 0.76rem;
    opacity: 0.88;
  }

  .medium-tag {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    padding: 0.15rem 0.42rem;
    border-radius: 999px;
    background: rgba(8, 10, 14, 0.68);
    color: #fff;
    backdrop-filter: blur(4px);
  }
  .cover[data-has-image='false'] .medium-tag {
    display: none;
  }

  .meta {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .title {
    margin: 0;
    font-weight: 600;
    font-size: 0.94rem;
    line-height: 1.3;
  }
  .creator {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-faint);
  }
  .note {
    margin: 0.3rem 0 0;
    font-size: 0.82rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  @media (max-width: 700px) {
    .track {
      grid-auto-columns: 62%;
    }
  }
</style>
