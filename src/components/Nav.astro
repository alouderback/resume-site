---
import { withBase, isActive } from '../lib/paths';
import { profile } from '../data/profile';
import { flag } from '../lib/flags';
import OrgSwitcher from './OrgSwitcher.astro';

const links = [
  { href: '/', label: 'Home' },
  { href: '/experience/', label: 'Experience' },
  { href: '/speaking/', label: 'Speaking' },
  { href: '/values/', label: 'Values' },
  { href: '/pipeline/', label: 'Pipeline' },
  { href: '/contact/', label: 'Contact' },
];

const here = Astro.url.pathname;
---

<nav class="site-nav" aria-label="Primary">
  <div class="wrap inner">
    <a class="brand" href={withBase('/')}>
      <span class="brand-name">{profile.name}</span>
      <span class="brand-tag">{profile.headline}</span>
    </a>

    <ul class="links">
      {
        links.map((l) => (
          <li>
            <a href={withBase(l.href)} aria-current={isActive(here, l.href) ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="right">
      {flag('showOrgSwitcher') && <OrgSwitcher />}
      <button type="button" class="theme" data-theme-toggle aria-label="Toggle colour theme">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>
  </div>
</nav>

<script>
  const btn = document.querySelector('[data-theme-toggle]');
  btn?.addEventListener('click', () => {
    const root = document.documentElement;
    const current =
      root.getAttribute('data-theme') ??
      (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* storage unavailable, the choice just will not persist */
    }
  });
</script>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .inner {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-block: 0.7rem;
    flex-wrap: wrap;
  }
  .brand {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--text);
    line-height: 1.25;
    margin-right: auto;
  }
  .brand-name {
    font-weight: 650;
    font-size: 0.98rem;
    letter-spacing: -0.01em;
  }
  .brand-tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-faint);
    letter-spacing: 0.02em;
  }
  .links {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }
  .links a {
    display: block;
    padding: 0.35rem 0.62rem;
    border-radius: 7px;
    font-size: 0.9rem;
    color: var(--text-muted);
    text-decoration: none;
    white-space: nowrap;
  }
  .links a:hover {
    color: var(--text);
    background: var(--bg-subtle);
  }
  .links a[aria-current='page'] {
    color: var(--brand-text);
    background: var(--brand-soft);
  }
  .right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .theme {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 7px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-muted);
    cursor: pointer;
  }
  .theme:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }
  @media (max-width: 820px) {
    .brand {
      margin-right: 0;
      width: 100%;
    }
    .links {
      order: 3;
      width: 100%;
    }
    .right {
      margin-left: auto;
    }
  }
</style>
