---
import type { SkillGroup } from '../data/skills';

interface Props {
  group: SkillGroup;
  index: number;
}

const { group, index } = Astro.props;
const num = String(index + 1).padStart(2, '0');
---

<article class="skill card" id={group.id}>
  <header>
    <span class="num mono">{num}</span>
    <h3>{group.name}</h3>
    <p class="summary">{group.summary}</p>
  </header>
  <ul>
    {
      group.items.map((item) => (
        <li>
          <span class="name">{item.name}</span>
          <span class="detail">{item.detail}</span>
        </li>
      ))
    }
  </ul>
</article>

<style>
  .skill {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
  }
  header {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.15rem 0.7rem;
    align-items: baseline;
  }
  .num {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--brand-text);
    letter-spacing: 0.08em;
  }
  h3 {
    margin: 0;
    font-size: 1.12rem;
  }
  .summary {
    grid-column: 2;
    margin: 0.3rem 0 0;
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.8rem;
    border-top: 1px solid var(--border);
    padding-top: 1rem;
  }
  li {
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
  }
  .name {
    font-weight: 600;
    font-size: 0.9rem;
  }
  .detail {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
  }
</style>
