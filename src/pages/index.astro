---
import BaseLayout from '../layouts/BaseLayout.astro';
import CoverCarousel from '../components/CoverCarousel.astro';
import { profile, eagles } from '../data/profile';
import { pillars } from '../data/values';
import { skillGroups } from '../data/skills';
import { withBase } from '../lib/paths';
import { flag } from '../lib/flags';
import { ENV } from '../lib/env';
---

<BaseLayout title="Salesforce DevOps Engineer" description={profile.summary}>
  <section class="hero wrap">
    <div class="hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">{profile.role} · {profile.company} · {profile.location}</span>
        <h1 class="display">{profile.name}</h1>
        <p class="tagline">{profile.headline}</p>
        <p class="lede">{profile.summary}</p>

        <div class="cta">
          <a class="btn btn--primary" href={withBase('/experience/')}>See the work</a>
          <a class="btn" href={withBase('/pipeline/')}>How this site ships</a>
          <a class="btn" href={withBase(profile.resumePdf)}>Resume (PDF)</a>
          <span class="cta-social">
            <a class="btn" href={profile.github} rel="me noopener">
              <svg
                width="16"
                height="16"
                viewBox="0 0 16 16"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
                ></path>
              </svg>
              GitHub
            </a>
            <a class="btn" href={profile.linkedin} rel="me noopener">
              <svg
                width="16"
                height="16"
                viewBox="0 0 16 16"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  d="M3.6 5.5H.9V15h2.7V5.5ZM2.25 1a1.57 1.57 0 1 0 0 3.14 1.57 1.57 0 0 0 0-3.14ZM15.1 9.4c0-2.6-1.39-3.81-3.24-3.81-1.5 0-2.17.82-2.54 1.4V5.5H6.62c.04.76 0 9.5 0 9.5h2.7V9.7c0-.24.02-.48.09-.65.19-.48.63-.98 1.37-.98.96 0 1.35.73 1.35 1.81V15h2.7V9.4Z"
                ></path>
              </svg>
              LinkedIn
            </a>
          </span>
        </div>
      </div>

      <figure class="hero-photo">
        <img
          src={withBase(profile.photo.src)}
          alt={profile.photo.alt}
          width="1050"
          height="1400"
          fetchpriority="high"
          decoding="async"
        />
        <figcaption>{profile.photo.caption}</figcaption>
      </figure>
    </div>
  </section>

  <section class="section wrap">
    <div class="eagles">
      <div class="eagles-head">
        <span class="wing" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
            <path
              d="M2 8c4.5-.4 7.6 1 9.6 3.2C13.4 13.2 14 15.6 14 18c2.6-1.4 4.4-3.5 5.3-5.6.9-2.1 1-4.2.7-5.9-1.5 1.6-3 2.2-4.4 2.2 1-1.3 1.4-2.6 1.3-3.8-2 1.3-4 1.6-6 1.3C8.2 5.7 5.6 6.3 2 8Z"
            ></path>
          </svg>
        </span>
        <h2 class="display">{eagles.title}</h2>
      </div>
      {eagles.lines.map((line) => <p>{line}</p>)}
    </div>
  </section>

  <section class="section wrap">
    <ul class="stats">
      {
        profile.stats.map((s) => (
          <li>
            <span class="v">{s.value}</span>
            <span class="l">{s.label}</span>
            <span class="c">{s.context}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section wrap">
    <span class="eyebrow">What I work with</span>
    <h2>Key skills</h2>
    <p class="lede">
      The toolchain behind the numbers above. Full detail sits on the experience page.
    </p>

    <ul class="skill-strip">
      {
        skillGroups.map((g) => (
          <li>
            <a href={withBase(`/experience/#${g.id}`)}>
              <span class="sg-name">{g.name}</span>
              <span class="sg-items">{g.items.map((i) => i.name).join(' · ')}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section wrap">
    <span class="eyebrow">How I work</span>
    <h2>What I optimise for</h2>
    <div class="pillars">
      {
        pillars.map((p, i) => (
          <a class="pillar card" href={withBase(`/values/#${p.id}`)}>
            <span class="pnum mono">{String(i + 1).padStart(2, '0')}</span>
            <h3>{p.title}</h3>
            <p>{p.short}</p>
          </a>
        ))
      }
    </div>
  </section>

  {
    flag('showWipSections') && (
      <section class="section wrap">
        <div class="lab">
          <div class="lab-head">
            <span class="tag tag--accent">Work in progress</span>
            <span class="mono faint">visible in {ENV.name} only</span>
          </div>
          <h2>The Lab</h2>
          <p class="lede">
            This block is gated behind the <code>showWipSections</code> flag, which is on in Sandbox
            and off everywhere else. It exists to prove the three environments are genuinely
            different builds rather than the same site in three colours. Anything drafted here gets
            promoted to Test and then Production by flipping the flag, which is the same path a real
            feature takes.
          </p>
          <ul class="lab-list">
            <li>A writeup of the Own Secure to Gearset Backup migration.</li>
            <li>Notes from the Center of Excellence dashboard build.</li>
            <li>A longer piece on where agents actually belong in a release process.</li>
          </ul>
        </div>
      </section>
    )
  }

  <section class="section wrap">
    <CoverCarousel />
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(2.5rem, 7vw, 4.5rem) clamp(2rem, 5vw, 3rem);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
  }
  .hero h1 {
    font-size: clamp(2.6rem, 1.4rem + 4.6vw, 4.6rem);
  }

  .hero-photo {
    margin: 0;
    position: relative;
  }
  .hero-photo img {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: center 22%;
    border-radius: var(--radius-lg);
    border: 3px solid var(--brand);
    box-shadow: var(--shadow);
  }
  .hero-photo figcaption {
    margin-top: 0.65rem;
    font-family: var(--font-mono);
    font-size: 0.71rem;
    line-height: 1.5;
    color: var(--text-faint);
  }

  .eagles {
    border: 1px solid color-mix(in srgb, var(--brand) 40%, var(--border));
    border-left: 4px solid var(--brand);
    border-radius: var(--radius-lg);
    background: var(--brand-soft);
    padding: 1.6rem 1.8rem;
  }
  .eagles-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.8rem;
  }
  .eagles-head h2 {
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.1rem);
  }
  .wing {
    color: var(--brand);
    display: grid;
    place-items: center;
  }
  .eagles p {
    color: var(--text-muted);
    max-width: 68ch;
    font-size: 0.96rem;
    line-height: 1.7;
  }
  .eagles p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 820px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-photo {
      order: -1;
      max-width: 320px;
    }
  }

  .tagline {
    font-family: var(--font-mono);
    font-size: clamp(1rem, 0.85rem + 0.6vw, 1.25rem);
    color: var(--brand-text);
    margin: 0.55rem 0 1.2rem;
    letter-spacing: -0.01em;
  }
  .hero .lede {
    font-size: 1.12rem;
    line-height: 1.7;
  }
  .cta {
    display: flex;
    gap: 0.7rem;
    flex-wrap: wrap;
    margin-top: 1.8rem;
  }
  /* Keeps GitHub and LinkedIn together when the row wraps, so neither ever
     ends up stranded alone on a second line. */
  .cta-social {
    display: flex;
    gap: 0.7rem;
  }

  .stats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1.5rem 1rem;
  }
  .stats li {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding-left: 0.9rem;
    border-left: 2px solid var(--brand);
  }
  .stats .v {
    font-size: 2rem;
    font-weight: 680;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }
  .stats .l {
    font-size: 0.92rem;
    color: var(--text);
  }
  .stats .c {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-faint);
    margin-top: 0.15rem;
  }

  .skill-strip {
    list-style: none;
    margin: 1.6rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .skill-strip a {
    display: grid;
    grid-template-columns: minmax(180px, 240px) 1fr;
    gap: 0.4rem 1.4rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    text-decoration: none;
    color: inherit;
    align-items: baseline;
  }
  .skill-strip a:hover {
    border-color: var(--brand);
    background: var(--surface-raised);
  }
  .sg-name {
    font-weight: 600;
    font-size: 0.96rem;
  }
  .sg-items {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-muted);
    line-height: 1.6;
  }
  @media (max-width: 700px) {
    .skill-strip a {
      grid-template-columns: 1fr;
    }
  }

  .pillars {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
    margin-top: 1.6rem;
  }
  .pillar {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    transition: border-color 0.15s ease;
  }
  .pillar:hover {
    border-color: var(--brand);
  }
  .pnum {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--brand-text);
    letter-spacing: 0.08em;
  }
  .pillar h3 {
    font-size: 1.02rem;
    line-height: 1.35;
  }
  .pillar p {
    margin: 0;
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .lab {
    border: 1px dashed color-mix(in srgb, var(--accent) 55%, transparent);
    border-radius: var(--radius-lg);
    background: var(--accent-soft);
    padding: 1.6rem;
  }
  .lab-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.8rem;
    flex-wrap: wrap;
  }
  .lab .faint {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-faint);
  }
  .lab code {
    font-family: var(--font-mono);
    font-size: 0.88em;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.05em 0.35em;
  }
  .lab-list {
    margin: 1rem 0 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.35rem;
    color: var(--text-muted);
    font-size: 0.92rem;
  }
  .lab-list li::marker {
    color: var(--accent);
  }
</style>
